{
  "name": "devtoolbox",
  "displayName": "DevToolbox 开发工具箱",
  "version": "1.0.0",
  "description": "时间戳转换（支持接管搜索框实时解析）、JSON 格式化、UUID 生成",
  "author": "BoxKit Official",
  "main": "index.html",
  "preload": "preload.js",
  "logo": "logo.svg",
  "permissions": ["clipboard", "notify"],
  "features": [
    {
      "code": "timestamp",
      "explain": "时间戳转换",
      "cmds": ["时间戳", "timestamp", "ts"]
    },
    {
      "code": "json",
      "explain": "JSON 格式化",
      "cmds": ["json", "格式化", "format"]
    },
    {
      "code": "uuid",
      "explain": "UUID 生成",
      "cmds": ["uuid", "guid"]
    }
  ]
}
